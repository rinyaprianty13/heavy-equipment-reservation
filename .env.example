# Copy to .env.local and fill in your values:
# cp .env.example .env.local

# PostgreSQL connection (Neon, local Postgres, or Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/emcl_reservation

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Local dev URL
BETTER_AUTH_URL=http://localhost:3000

# Required to call GET /api/seed
SEED_KEY=local-dev-seed
